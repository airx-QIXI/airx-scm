// AIRX 供应链管理系统 - Prisma 数据模型定义
// 生产环境：PlanetScale (MySQL) + Vercel Serverless
//
// 部署步骤：
// 1. 在 PlanetScale 创建数据库 airx_scm
// 2. 获取连接字符串填入 .env 的 DATABASE_URL
// 3. 运行 npx prisma db push 创建表结构
// 4. 运行 npm run db:seed 初始化种子数据

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// 用户模型
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String?  @unique
  fullName  String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 模块注册表模型
model Module {
  id          String   @id
  name        String
  icon        String   @default("AppstoreOutlined")
  description String   @default("")
  type        String   @default("builtin")
  path        String?
  entryUrl    String?  @db.Text
  apiBaseUrl  String?  @db.Text
  status      String   @default("active")
  sortOrder   Int      @default(0)
  version     String   @default("0.0.0")
  dataSource  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 外部项目识别结果
model IntegrationProject {
  id          Int                       @id @default(autoincrement())
  externalId  String                    @unique
  code        String?
  sku         String                    @unique
  name        String
  brand       String?
  category    String?
  modelName   String?
  source      String                    @default("jd_self_operated")
  rawData     String                    @db.Text
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  snapshots   ProductionRestockSnapshot[]
}

// 预测看板快照
model ProductionRestockSnapshot {
  id                  Int                @id @default(autoincrement())
  projectId           Int
  sourceCacheTime     DateTime?
  availableStock      Float              @default(0)
  factoryStock        Float              @default(0)
  inTransitStock      Float              @default(0)
  sales7Days          Float              @default(0)
  sales30Days         Float              @default(0)
  avgDailySales       Float              @default(0)
  turnoverDays        Float?
  turnoverRate30Days  Float              @default(0)
  recommendedRestock  Int                @default(0)
  riskLevel           String             @default("NORMAL")
  inventoryTurnover   String             @db.Text
  inventoryAnalysis   String             @db.Text
  restockReminder     String             @db.Text
  rawData             String             @db.Text
  syncedAt            DateTime           @default(now())
  project             IntegrationProject @relation(fields: [projectId], references: [id])

  @@index([projectId, syncedAt])
  @@index([riskLevel])
}
