{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "frontend", "backend"]
}
