# ============================================
# AIRX 供应链管理系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# 在 Vercel 中将这些变量配置到 Project Settings → Environment Variables

# PlanetScale 数据库连接字符串
# 格式: mysql://用户名:密码@主机/数据库名?ssl={"rejectUnauthorized":true}
# 示例: mysql://xxxxxxxx:pscale_pw_xxxxxxxx@us-east.connect.psdb.cloud/airx_scm?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://username:password@host/airx_scm?ssl={\"rejectUnauthorized\":true}"

# JWT 密钥（请使用随机长字符串）
JWT_SECRET="airx-scm-jwt-secret-change-this-to-a-random-string"

# JWT 过期时间
JWT_EXPIRES_IN="7d"
